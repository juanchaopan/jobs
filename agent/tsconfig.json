{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    "allowJs": true,
    "checkJs": false,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
