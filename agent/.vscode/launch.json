{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Subscriber",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/subscriber.js",
      "preLaunchTask": "npm: build",
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run test-apply.ts (tsx)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "${workspaceFolder}/src/test-apply.ts"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run test-captcha.ts (tsx)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "${workspaceFolder}/src/test-captcha.ts",
        "${input:dumpFile}"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development",
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "outputCapture": "std"
    }
  ],
  "inputs": [
    {
      "id": "dumpFile",
      "type": "promptString",
      "description": "Path to invoke dump JSON file",
      "default": "/tmp/invoke-"
    }
  ]
}